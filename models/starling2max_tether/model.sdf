</link>

<plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <odom_topic>/starling2max_tether/payload/odom</odom_topic>
    <odom_frame>world</odom_frame>
    <robot_base_frame>payload</robot_base_frame>
    <dimensions>3</dimensions>
</plugin>
</model>

<plugin filename="TetherPlugin" name="tether_plugin::TetherPlugin">
    <drone_link>base_link</drone_link>
    <payload_link>payload::payload</payload_link>
    <rest_length>
        3
    </rest_length>
    <stiffness>
        1500
    </stiffness>
    <damping>
        200
    </damping>
    <torsional_damping>
        0.0002
    </torsional_damping>
    <gate_tension>
        0.3
    </gate_tension>
    <cable>
        <drone_attach>
            0.0289 0 -0.02
        </drone_attach>
        <payload_attach>
            0.09 0 0.025
        </payload_attach>
    </cable>
