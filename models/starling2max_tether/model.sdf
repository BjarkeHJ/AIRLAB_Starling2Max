            <rollingMomentCoefficient>4.19146e-07</rollingMomentCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <!-- motor 3: rear_right, cw -->
        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <jointName>rotor_3_joint</jointName>
            <linkName>rotor_3</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>1000</maxRotVelocity>
            <motorConstant>3.5831e-06</motorConstant>
            <momentConstant>0.015</momentConstant>
            <commandSubTopic>command/motor_speed</commandSubTopic>
            <motorNumber>3</motorNumber>
            <rotorDragCoefficient>3.38011e-05</rotorDragCoefficient>
            <rollingMomentCoefficient>4.19146e-07</rollingMomentCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>

        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_topic>/starling2max_tether/drone/odom</odom_topic>
            <odom_frame>world</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <dimensions>3</dimensions>
        </plugin>

        <frame name="attach0" attached_to="base_link">
            <pose relative_to="base_link">0.0289 0 -0.02 0 0 0</pose>
        </frame>
        <frame name="attach1" attached_to="base_link">
            <pose relative_to="base_link">-0.01445 0.0250281 -0.02 0 0 0</pose>
        </frame>
        <frame name="attach2" attached_to="base_link">
            <pose relative_to="base_link">-0.01445 -0.0250281 -0.02 0 0 0</pose>
        </frame>

<!-- slung payload: free body (no joint), held only by TetherPlugin.
     Nested model so it gets its own OdometryPublisher (that plugin reports the
     pose of the model it is attached to, i.e. its canonical link) -->
<model name="payload">
<pose>0.5 0 0.025 0 0 0</pose>
<link name="payload">
    <inertial>
        <mass>0.4</mass>
        <inertia>
            <ixx>0.00141667</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
