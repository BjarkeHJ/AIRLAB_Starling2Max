#!/bin/sh
#
# @name Gazebo Starling 2 Max
#
# @type Quadrotor
#
# @maintainer AIRLAB
#
# GENERATED by starling2max/generate.py - Edit template instead
#
# Hover estimate: {{ hover_velocity | num(4) }} rad/s, throttle {{ hover_throttle | num(3) }}, max T/W {{ max_t2w | num(3) }}
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:={{ name }}}

param set-default SIM_GZ_EN 1

# control allocation: quad-X positions in FRD [m], KM > 0 for ccw
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT {{ rotors | length }}

{% for rotor in rotors %}
# rotor {{ rotor.index }}: {{ rotor.name }}, {{ rotor.direction }}
param set-default CA_ROTOR{{ rotor.index }}_PX {{ rotor.ca_px | num }}
param set-default CA_ROTOR{{ rotor.index }}_PY {{ rotor.ca_py | num }}
param set-default CA_ROTOR{{ rotor.index }}_KM {{ rotor.ca_km | num }}
{% endfor %}

# Gazebo ESC outputs: motor N -> SIM_GZ_EC channel N+1, speeds in rad/s
{% for rotor in rotors %}
param set-default SIM_GZ_EC_FUNC{{ rotor.index + 1}} {{ 101 + rotor.index }}
{% endfor %}

{% for rotor in rotors %}
param set-default SIM_GZ_EC_MIN{{ rotor.index + 1 }} {{ min_rot_velocity | int}}
{% endfor %}

{% for rotor in rotors %}
param set-default SIM_GZ_EC_MAX{{ rotor.index + 1}} {{ max_rot_velocity | int }}
{% endfor %}

param set-default MPC_THR_HOVER {{ '%.2f' | format(hover_throttle) }}

{% if px4_params %}
{% for key, value in px4_params.items() %}
param set-default {{ key }} {{ value }}
{% endfor %}
{% endif %}