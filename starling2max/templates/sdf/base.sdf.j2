<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED by starling2max/generate.py from config/ - Edit the template instead -->
<sdf version='1.9'>
    <model name='{{ base_model }}'>
        <pose>0 0 {{ spawn_z | num }} 0 0 0</pose>
        <self_collide>false</self_collide>
        <static>false</static>

        <link name="base_link">
            <inertial>
                <mass>{{ base_mass | num }}</mass>
                <inertia>
                    <ixx>{{ base_inertia[0] | num }}</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>{{ base_inertia[1] | num }}</iyy>
                    <iyz>0</iyz>
                    <izz>{{ base_inertia[2] | num }}</izz>
                </inertia>
            </inertial>
            <gravity>true</gravity>
            <velocity_decay />

            <visual name="base_link_visual">
                <geometry>
                    <mesh>
                        <scale>{{ mesh_scale | vec }}</scale>
                        <uri>model://{{ base_model }}/meshes/{{ body_mesh }}</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>{{ 'grey' | rgba }}</ambient>
                    <diffuse>{{ 'grey' | rgba }}</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <collision name="base_link_collision">
                <geometry>
                    <box>
                        <size>{{ bbox | vec }}</size>
                    </box>
                </geometry>
                <surface>
                    <contact>
                        <ode>
                            <min_depth>0.001</min_depth>
                            <max_vel>0</max_vel>
                        </ode>
                    </contact>
                    <friction>
                        <ode />
                    </friction>
                </surface>
            </collision>

            <!-- PX4 gz_bridge subscribes to these sensors by name on base_link -->
            <sensor name="air_pressure_sensor" type="air_pressure">
                <gz_frame_id>base_link</gz_frame_id>
                <always_on>1</always_on>
                <update_rate>50</update_rate>
                <air_pressure>
                    <pressure>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>3.0</stddev>
                        </noise>
                    </pressure>
                </air_pressure>
            </sensor>

            <sensor name="magnetometer_sensor" type="magnetometer">
                <gz_frame_id>base_link</gz_frame_id>
                <always_on>1</always_on>
                <update_rate>100</update_rate>
                <magnetometer>
                    {% for axis in ['x', 'y', 'z'] %}
                    <{{ axis }}>
                    <noise type="gaussian">
                        <stddev>0.0001</stddev>
                    </noise>
                    </{{ axis }}>
                    {% endfor %}
                </magnetometer>
            </sensor>

            <sensor name="imu_sensor" type="imu">
                <gz_frame_id>base_link</gz_frame_id>
                <always_on>1</always_on>
                <update_rate>250</update_rate>
                <imu>
                    <angular_velocity>
                    {% for axis in ['x', 'y', 'z']%}
                    <{{ axis }}>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.0008726646</stddev>
                    </noise>
                    </{{ axis }}>
                    {% endfor %}
                    </angular_velocity>
                    <linear_acceleration>
                    {% for axis, stddev in [('x', 0.00637), ('y', 0.00638), ('z', 0.00686)] %}
                    <{{ axis }}>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>{{ stddev }}</stddev>
                    </noise>
                    </{{ axis }}>
                    {% endfor %}
                    </linear_acceleration>
                </imu>
            </sensor>

            <sensor name="navsat_sensor" type="navsat">
                <gz_frame_id>base_link</gz_frame_id>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
            </sensor>
        </link>

        {% for rotor in rotors %}
        <link name="rotor_{{ rotor.index }}">
            <pose>{{ rotor.xyz | vec }} 0 0 0</pose>
            <gravity>true</gravity>
            <velocity_decay />
            <inertial>
                <mass>{{ prop_mass | num }}</mass>
                <inertia>
                    <ixx>{{ prop_inertia[0] | num }}</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>{{ prop_inertia[1] | num }}</iyy>
                    <iyz>0</iyz>
                    <izz>{{ prop_inertia[2] | num }}</izz>
                </inertia>
            </inertial>
            <visual name="rotor_{{ rotor.index }}_visual">
                <geometry>
                    <mesh>
                        <scale>{{ mesh_scale | vec }}</scale>
                        <uri>model://{{ base_model }}/meshes/{{ prop_mesh }}</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>{{ rotor.color | rgba }}</ambient>
                    <diffuse>{{ rotor.color | rgba }}</diffuse>
                </material>
            </visual>
        </link>
        <joint name="rotor_{{ rotor.index }}_joint" type="revolute">
            <parent>base_link</parent>
            <child>rotor_{{ rotor.index }}</child>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
            </axis>
        </joint>
        {% endfor %}
    </model>
</sdf>