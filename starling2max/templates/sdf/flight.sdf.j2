<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED by starling2max/generate.py from config/ - Edit the template instead -->
<sdf version='1.9'>
    <model name='{{ name }}'>
        <include merge='true'>
            <uri>model://{{ base_model }}</uri>
        </include>

        {% for rotor in rotors %}
        <!-- motor {{ rotor.index }}: {{ rotor.name }}, {{ rotor.direction }} -->
        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <jointName>rotor_{{ rotor.index }}_joint</jointName>
            <linkName>rotor_{{ rotor.index }}</linkName>
            <turningDirection>{{ rotor.direction }}</turningDirection>
            <timeConstantUp>{{ time_constant_up | num }}</timeConstantUp>
            <timeConstantDown>{{ time_constant_down | num }}</timeConstantDown>
            <maxRotVelocity>{{ max_rot_velocity | num }}</maxRotVelocity>
            <motorConstant>{{ motor_constant | num }}</motorConstant>
            <momentConstant>{{ moment_constant | num }}</momentConstant>
            <commandSubTopic>command/motor_speed</commandSubTopic>
            <motorNumber>{{ rotor.index }}</motorNumber>
            <rotorDragCoefficient>{{ rotor_drag | num }}</rotorDragCoefficient>
            <rollingMomentCoefficient>{{ rolling_moment | num }}</rollingMomentCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        {% endfor %}

        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_topic>{{ ground_truth_topic }}</odom_topic>
            <odom_frame>world</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <dimensions>3</dimensions>
        </plugin>

        {% if frames %}
        {% for frame, spec in frames.items() %}
        <frame name="{{ frame }}" attached_to="base_link">
            <pose relative_to="base_link">{{ spec.xyz | vec }} 0 0 0</pose>
        </frame>
        {% endfor %}
        {% endif %}
    </model>
</sdf>