<?xml version="1.0" ?>
<!-- GENERATED by starling2max/generate.py from config/. Edit the template instead. -->
<robot name="{{ name }}">

    <properties kf="{{ kf | num }}" km="{{ km | num }}"/>

    <material> 
        name="grey"<color 
        rgba="{{ 'grey' | rgba }}"/>
    </material>
    <material>
        name="green"<color 
        rgba="{{ 'green' | rgba }}"/>
    </material>
    <material>
        name="red"<color 
        rgba="{{ 'red' | rgba }}"/>
    </material>

    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="{{ base_mass | num }}"/>
            <inertia ixx="{{ base_inertia[0] | num }}" ixy="0" ixz="0" iyy="{{ base_inertia[1] | num }}" iyz="0" izz="{{ base_inertia[2] | num}}"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../{{ base_model }}/meshes/{{ body_mesh }}" scale="{{ mesh_scale | vec }}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="{{ bbox | vec }}"/>
            </geometry>
        </collision>
    </link>

{% for rotor in genesis_rotors %}
    <!-- prop{{ loop.index0 }}: {{ rotor.name }}, {{ rotor.spin }} -->
    <link name="prop{{ loop.index0 }}_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="{{ prop_mass | num }}"/>
            <inertia ixx="{{ prop_inertia[0] | num }}" ixy="0" ixz="0" iyy="{{ prop_inertia[1] | num }} iyz=0" izz="{{ prop_inertia[2] | num }}"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../{{ base_model }}/meshes/{{ prop_mesh }}" scale="{{ mesh_scale | vec }}"/>
            </geometry>
            <material name="{{ rotor.color }}"/>
        </visual>
    </link>
    <joint name="prop{{ loop.index0 }}_joint" type="fixed">
        <origin xyz="{{ rotor.xyz | vec }}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="prop{{ loop.index0 }}_link"/>
    </joint>
{% endfor %}

{% for frame, spec in frames.items() %}
    <link name="{{ frame }}_link"/>
    <joint name="{{ frame }}_joint" type="fixed">
        <origin xyz="{{ spec.xyz | vec }}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="{{ frame }}_link"/>
    </joint>
{% endfor %}

</robot>