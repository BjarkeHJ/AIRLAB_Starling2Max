<?xml version="1.0" ?>
<!-- GENERATED by starling2max/generate.py from config/ - Edit the template instead -->
{% set pl = tether.payload %}
<robot name="{{ name }}_payload">
    {% for color in ("blue", "red", "green") %}
    <material name="{{ color }}"><color rgba="{{ color | rgba }}"/></material>
    {% endfor %}

    <link name="{{ pl.link }}">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="{{ pl.mass | num }}"/>
            <inertia ixx="{{ pl.inertia[0] | num }}" ixy="0" ixz="0" iyy="{{ pl.inertia[1] | num }}" iyz="0" izz="{{ pl.inertia[2] | num }}"/>
        </inertial>
        {% for v in pl.visuals %}
        <visual name="{{ v.name }}">
            <origin xyz="{{ v.xyz | vec }}" rpy="{{ v.rpy | vec }}"/>
            <geometry><box size="{{ v.size | vec }}"/></geometry>
            <material name="{{ v.color }}"/>
        </visual>
        {% endfor %}
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="{{ pl.size | vec }}"/></geometry>
        </collision>
    </link>

    {% for xyz in pl.attach %}
    <link name="attach{{ loop.index0 }}_link">
        <visual><geometry><sphere radius="{{ pl.marker_radius | num }}"/></geometry><material name="red"/></visual>
    </link>
    <joint name="attach{{ loop.index0 }}_joint" type="fixed">
        <origin xyz="{{ xyz | vec }}" rpy="0 0 0"/>
        <parent link="{{ pl.link }}"/>
        <child link="attach{{ loop.index0 }}_link"/>
    </joint>
    {% endfor %}
</robot>
